# Number of synthetic cases to generate per run (default: 2)
N_CASES=2

# OpenAI API key (required for refugee, consultant agents)
OPENAI_API_KEY=sk-...

# DeepSeek API key (required for evaluator agent)
DEEPSEEK_API_KEY=...
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# --- Consultant web access (optional, defaults shown) ---
CONSULTANT_ENABLE_WEB=true
CONSULTANT_ALLOWED_DOMAINS=gov.pl,zus.pl,podatki.gov.pl,biznes.gov.pl,euraxess.pl,ec.europa.eu
CONSULTANT_WEB_TIMEOUT_MS=20000
CONSULTANT_WEB_MAX_SOURCES=4
CONSULTANT_WEB_CACHE_DIR=books_consultant/live_web_cache

# --- Tavily search (optional, disabled by default) ---
# Get free API key at https://tavily.com (1000 searches/month free)
TAVILY_API_KEY=tvly-...
CONSULTANT_ENABLE_TAVILY=false
